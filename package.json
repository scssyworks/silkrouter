{
  "name": "silkrouter",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./web": {
      "import": "./dist/web/es/index.mjs",
      "require": "./dist/web/cjs/index.cjs",
      "types": "./dist/web/main.d.ts",
      "default": "./dist/web/es/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:playground": "vite build --config vite.playground.config.ts",
    "format": "prettier --write .",
    "test": "vitest run --config vitest.config.ts --coverage"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.7",
    "@types/node": "25.9.0",
    "@vitest/coverage-v8": "4.1.7",
    "happy-dom": "20.9.0",
    "prettier": "3.8.3",
    "terser": "5.48.0",
    "typescript": "6.0.2",
    "unplugin-dts": "1.0.0",
    "vite": "8.0.12",
    "vitest": "4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scssyworks/silkrouter.git"
  },
  "keywords": [
    "router",
    "browserrouter",
    "clientrouter",
    "memoryrouter",
    "hashrouter",
    "silkrouter"
  ],
  "author": "scssyworks",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/scssyworks/silkrouter/issues"
  },
  "homepage": "https://github.com/scssyworks/silkrouter#readme",
  "dependencies": {
    "xss": "1.0.15"
  }
}

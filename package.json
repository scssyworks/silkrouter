{
  "name": "silkrouter",
  "version": "0.0.0",
  "type": "module",
  "description": "Silk router is an app routing library",
  "main": "dist/umd/silkrouter.min.js",
  "module": "dist/esm/silkrouter.esm.min.js",
  "types": "dist/typings/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/silkrouter.esm.min.js",
      "require": "./dist/umd/silkrouter.min.js",
      "types": "./dist/typings/index.d.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "start": "npm run clean && node plugins/watch-config.mjs -- env-cmd -f ./.env.start rollup -c --watch",
    "dev": "npm run clean && env-cmd -f ./.env.dev rollup -c",
    "dev:serve": "npm run clean && env-cmd -f ./.env.start.prod rollup -c",
    "dist": "npm run dev && npm run dev:serve && npm run prod",
    "prod": "env-cmd rollup -c",
    "build": "npm run clean && npm run check:sanity && npm run test && npm run dist && npm run typings",
    "test": "echo 'Tests disabled'",
    "deploy": "gh-pages -d dist",
    "check:sanity": "biome check --write src/",
    "typings": "tsc src/js/index.js --declaration --allowJs --emitDeclarationOnly --outDir dist/typings"
  },
  "author": "scssyworks",
  "license": "MIT",
  "keywords": [
    "router",
    "browserrouter",
    "silkrouter",
    "pushstate",
    "popstate",
    "history",
    "rxjs",
    "observables"
  ],
  "files": [
    "dist/umd/",
    "dist/esm/",
    "dist/typings/",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scssyworks/silkrouter.git"
  },
  "bugs": {
    "url": "https://github.com/scssyworks/silkrouter/issues"
  },
  "homepage": "https://scssyworks.github.io/silkrouter",
  "peerDependencies": {
    "rxjs": "^7.8.1"
  },
  "dependencies": {
    "core-js": "3.49.0",
    "is-number": "7.0.0",
    "is-object": "1.0.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@biomejs/biome": "2.5.2",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-eslint": "9.2.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@types/node": "26.1.0",
    "env-cmd": "11.0.0",
    "eslint": "9.39.4",
    "gh-pages": "6.3.0",
    "rollup": "4.62.2",
    "rollup-plugin-livereload": "2.0.5",
    "rollup-plugin-serve": "3.0.0",
    "rxjs": "7.8.2",
    "typescript": "6.0.3"
  }
}
